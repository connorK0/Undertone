# Copy to .env and fill in what you need. .env is gitignored; never commit real keys.

# Needed for --model opus and --model haiku. Not needed for --model local.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which Ollama model --model local uses. Must already be pulled:
#   ollama pull qwen2.5:7b
# Fits fully in 8GB of VRAM. Larger, slower, possibly sharper: qwen2.5:14b or phi4.
OLLAMA_MODEL=qwen2.5:7b

# Not used in Phase 0. The mapper prints music parameters; it doesn't call a
# music API yet. Placeholder so Phase 3 has somewhere to put it.
MUBERT_API_KEY=
